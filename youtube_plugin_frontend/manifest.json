{
  "manifest_version": 3,
  "name": "YouTube Sentiment Insights",
  "version": "1.1",
  "description": "Analyzes YouTube video comments for sentiment.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "activeTab"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://www.googleapis.com/*"
  ]
}
